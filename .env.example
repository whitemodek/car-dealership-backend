# Generate a complete .env with: go run ./backend/cmd/envgen
# Credentials are deliberately empty. Existing .env files are never overwritten.
POSTGRES_PASSWORD=
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000
RESERVATION_DURATION=24h
# Optional: without a webhook, transactional events remain pending in the DB.
WEBHOOK_URL=
WEBHOOK_SECRET=
