# Local development only. Replace both password occurrences before use.
POSTGRES_PASSWORD=replace-with-a-random-local-password
# URL-encode special characters in the password. db is the Compose service name.
DATABASE_URL=postgres://dealership:replace-with-a-random-local-password@db:5432/dealership?sslmode=disable
CORS_ORIGINS=http://localhost:3000
RESERVATION_DURATION=24h
# Optional: without a webhook, transactional events remain pending in the DB.
WEBHOOK_URL=
WEBHOOK_SECRET=
